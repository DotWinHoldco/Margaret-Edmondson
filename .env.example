# === App ===
NEXT_PUBLIC_SITE_URL=https://artbyme.studio
NEXT_PUBLIC_SITE_NAME="ArtByMe"

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Stripe ===
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Test-mode keys (used while site_settings.stripe_test_mode = true)
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=

# === Lumaprints ===
LUMAPRINTS_API_KEY=
LUMAPRINTS_API_SECRET=
LUMAPRINTS_BASE_URL=https://us.api.lumaprints.com
LUMAPRINTS_STORE_ID=
LUMAPRINTS_WEBHOOK_SECRET=

# === Printful ===
PRINTFUL_ACCESS_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_SECRET=

# === ShipStation ===
SHIPSTATION_API_KEY=
SHIPSTATION_BASE_URL=https://ssapi.shipstation.com/v2
SHIPSTATION_WEBHOOK_SECRET=

# === Email (Resend) ===
RESEND_API_KEY=
EMAIL_FROM="ArtByMe <hello@artbyme.studio>"
RESEND_WEBHOOK_SECRET=
# Optional, defaults to CRON_SECRET. Used to sign one-click unsubscribe tokens.
UNSUBSCRIBE_SECRET=
# Recipient for admin "Send test" integration checks (Resend/Meta).
EMAIL_TEST_RECIPIENT=hello@artbyme.studio

# === Meta / Facebook ===
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# === Social content calendar ===
# Phase 2 Meta Graph auto-publish flag — leave off (Phase 1 sends reminders only).
SOCIAL_AUTOPUBLISH=false
# Optional override for who receives the "time to post" cron reminder
# (defaults to the first admin/artist profile email, then EMAIL_FROM).
SOCIAL_REMINDER_EMAIL=

# === Anthropic (AI: shared-file processing, content assists) ===
ANTHROPIC_API_KEY=

# === Google OAuth (optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Vercel ===
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
CRON_SECRET=
