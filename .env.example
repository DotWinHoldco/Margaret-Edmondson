# === App ===
NEXT_PUBLIC_SITE_URL=https://artbyme.studio
NEXT_PUBLIC_SITE_NAME="ArtByMe"

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Stripe ===
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Test-mode keys (used while site_settings.stripe_test_mode = true)
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=

# === Lumaprints ===
LUMAPRINTS_API_KEY=
LUMAPRINTS_API_SECRET=
LUMAPRINTS_BASE_URL=https://us.api.lumaprints.com
LUMAPRINTS_STORE_ID=
LUMAPRINTS_WEBHOOK_SECRET=
# SANDBOX (custom-sizing build): all master/order dry-runs MUST hit the sandbox
# host, never production. Point LUMAPRINTS_BASE_URL at the sandbox and use the
# matching sandbox key set (issued at sandbox.lumaprints.com → Developer → API).
# Never place a production order until human sign-off.
#   LUMAPRINTS_BASE_URL=https://us.api-sandbox.lumaprints.com

# === Printful ===
PRINTFUL_ACCESS_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_SECRET=

# === ShipStation ===
SHIPSTATION_API_KEY=
SHIPSTATION_BASE_URL=https://ssapi.shipstation.com/v2
SHIPSTATION_WEBHOOK_SECRET=

# === Email (Resend) ===
RESEND_API_KEY=
EMAIL_FROM="ArtByMe <hello@artbyme.studio>"
RESEND_WEBHOOK_SECRET=
# REQUIRED in production. Dedicated HMAC secret for one-click unsubscribe tokens.
# COM-3: there is no fallback to CRON_SECRET/RESEND_API_KEY anymore — reusing
# those let tokens be forged. If unset in production, signing/verifying tokens
# fails closed (marketing sends that build an unsubscribe link will error).
# Generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=
# Recipient for admin "Send test" integration checks (Resend/Meta).
EMAIL_TEST_RECIPIENT=hello@artbyme.studio

# === Meta / Facebook ===
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# === Social content calendar ===
# Phase 2 Meta Graph auto-publish flag — leave off (Phase 1 sends reminders only).
SOCIAL_AUTOPUBLISH=false
# Optional override for who receives the "time to post" cron reminder
# (defaults to the first admin/artist profile email, then EMAIL_FROM).
SOCIAL_REMINDER_EMAIL=

# === Anthropic (AI: shared-file processing, content assists) ===
ANTHROPIC_API_KEY=

# === Google OAuth (optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Site access / anti-bot ===
# REQUIRED in production. HMAC secret for the pre-launch site gate and for the
# anti-bot intent tokens the public forms (contact, newsletter, commissions,
# reference-photo uploads) must present. If unset in production those forms fail
# closed with 403 anti_bot rather than accepting tokens signed with a guessable
# development secret. Generate with: openssl rand -hex 32
SITE_AUTH_SECRET=
# Optional pre-launch gate password (site_settings.gate_* takes precedence).
SITE_PASSWORD=

# === Vercel ===
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
CRON_SECRET=

# === Site gate + signing ===
# Pre-launch password gate (site_settings.gate_password / gate_secret override
# these; the env pair is the fallback so a missing DB row cannot strand the
# site). SITE_AUTH_SECRET also signs guest cart tokens: without it, production
# refuses to issue or accept them and guest carts stop being tracked server-side.
# Generate with: openssl rand -hex 32
SITE_PASSWORD=
SITE_AUTH_SECRET=
