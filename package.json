  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "node scripts/check-env.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:rls": "node scripts/check-rls.mjs",
