    "check:atomicity": "node scripts/check-atomicity.mjs",
    "check:events": "node scripts/check-event-boundaries.mjs",
    "check:reads": "node scripts/check-read-boundary.mjs",
    "check:dup-tx": "node scripts/check-no-duplicate-transactions.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "build-check": "node scripts/build-check.mjs",
    "build-check:write": "node scripts/build-check.mjs --write-state",
    "build-check:strict": "node scripts/build-check.mjs --docs-strict",
    "verify": "node scripts/build-check.mjs --tier=pre --since=HEAD",
